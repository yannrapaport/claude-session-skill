#!/usr/bin/env bash
# session-reconcile [<session-id>] — settle local copies of sessions that
# another machine now owns (meta.owner), after a migration:
#   running here               untouched, diverged flag left as it was
#   supervisor unreadable      untouched, diverged flag left as it was (fail closed)
#   identical to fingerprint   trash (session-trash: moved, never deleted)
#   anything else              diverged: untouched, listed in session-diverged.json
# Full run (no id) also empties trash days older than 30 days.
# With an id (called over ssh right after a migration) it syncs the hub first.
set -euo pipefail
ONE="${1:-}"
if [ -n "$ONE" ] && ! [[ "$ONE" =~ ^[0-9a-fA-F-]+$ ]]; then
  echo "session-reconcile: identifiant invalide « $ONE »" >&2; exit 1
fi
THIS=$(session-config machine)
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
[ -n "$CLAUDE_DIR" ] || { echo "session-reconcile: CLAUDE_DIR vide" >&2; exit 1; }
CLAUDE=$(session-config claude_bin 2>/dev/null || echo claude)
DIV="$CLAUDE_DIR/session-diverged.json"
[ -z "$ONE" ] || session-hub-sync >/dev/null 2>&1 || true
META=$(mktemp); trap 'rm -f "$META"' EXIT
session-metastore all > "$META"
shopt -s nullglob
FILES=()
for f in "$CLAUDE_DIR"/projects/*/*.jsonl; do
  sid=$(basename "$f" .jsonl)
  [[ "$sid" =~ ^[0-9a-fA-F-]+$ ]] || continue
  [ -z "$ONE" ] || [ "$sid" = "$ONE" ] || continue
  FILES+=("$f")
done
# One line per local copy owned elsewhere: <sid> <state> <size> <sha256> <path>
# The supervisor is read once per run, and only when there is something to
# settle; same running/stopped/unknown/error semantics as session-agents-state.
PLAN=$(python3 - "$META" "$CLAUDE" "$THIS" "${FILES[@]:-}" << 'PYEOF'
import json, os, subprocess, sys
meta_path, claude, this, *files = sys.argv[1:]
meta = json.load(open(meta_path))
agents = False                 # not read yet
def read_agents():
    try:
        out = subprocess.run([claude, "agents", "--json", "--all"], capture_output=True,
                             text=True, check=True).stdout
        d = json.loads(out)
        return d if isinstance(d, list) else d.get("sessions", [])
    except (OSError, subprocess.CalledProcessError, ValueError, AttributeError):
        return None
def state(sid):
    global agents
    if agents is False:
        agents = read_agents()
    if agents is None:
        return "error"
    st = "unknown"
    for s in agents:
        if s.get("sessionId") != sid:
            continue
        if "pid" in s or s.get("status"):
            return "running"
        st = "stopped"
    return st
for f in files:
    if not f:
        continue
    sid = os.path.basename(f)[:-len(".jsonl")]
    m = meta.get(sid, {})
    owner = m.get("owner") or ""
    if not owner or owner == this:
        continue
    fp = m.get("fingerprint") or {}
    print(sid, state(sid), fp.get("size", "-"), fp.get("sha256", "-"), f)
PYEOF
)
NEW_DIV=(); KEEP=()
while read -r sid st size sha f; do
  [ -n "$sid" ] || continue
  case "$st" in
    running) KEEP+=("$sid"); continue ;;
    error) KEEP+=("$sid"); echo "session-reconcile: état de ${sid:0:8} illisible — laissée en l'état" >&2; continue ;;
  esac
  cur=$(session-fingerprint "$f" | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d["size"],d["sha256"])') || continue
  if [ "$size" != "-" ] && [ "$cur" = "$size $sha" ]; then
    session-trash "$sid" >/dev/null || KEEP+=("$sid")   # refused: leave it as it was
  else
    NEW_DIV+=("$sid")
  fi
done <<< "$PLAN"
# Rewrite the diverged list: ids settled this run take their new state,
# ids that could not be settled (KEEP) keep their previous one.
python3 - "$DIV" "$ONE" "${KEEP[*]:-}" "${NEW_DIV[*]:-}" << 'PYEOF'
import json, os, sys
path, one, keep, ids = sys.argv[1:]
keep, ids = set(keep.split()), set(ids.split())
try:
    prev = set(json.load(open(path)))
except (OSError, ValueError, TypeError):
    prev = set()
if one:                       # single-id run: only that id may change
    out = (prev - {one}) | ids | (prev & keep)
else:
    out = ids | (prev & keep)
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(sorted(out), fh)
os.replace(tmp, path)
PYEOF
# Purge: only direct children of the trash that are day directories (YYYY-MM-DD).
TRASH="$CLAUDE_DIR/session-trash"
if [ -z "$ONE" ] && [ -d "$TRASH" ] && [ ! -L "$TRASH" ]; then
  find "$TRASH" -mindepth 1 -maxdepth 1 -type d \
    -name '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' -mtime +30 -exec rm -rf {} +
fi
