#!/usr/bin/env bash
# Commit all changes in hub and push.
# Usage: session-hub-push "commit message"
# Holds the hub lock (session-hub-lock) so it never interleaves with a migration.
set -euo pipefail
MSG="${1:-"session hub update"}"
HUB_DIR="${HUB_DIR_OVERRIDE:-$HOME/.claude/session-hub}"
session-hub-lock acquire
trap 'session-hub-lock release' EXIT
git -C "$HUB_DIR" add -A
# Exit cleanly if nothing to commit
git -C "$HUB_DIR" diff --cached --quiet && exit 0
git -C "$HUB_DIR" commit -m "$MSG"
git -C "$HUB_DIR" push origin HEAD
