<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.yann.session-gc-sessions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>PATH="$HOME/.claude/skills/session/bin:$PATH" session-gc-sessions</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key><dict>
    <key>GC_CHECKPOINT_CMD</key><string>true</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/session-gc-sessions.log</string>
  <key>StandardErrorPath</key><string>/tmp/session-gc-sessions.err</string>
</dict></plist>
