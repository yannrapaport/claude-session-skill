#!/usr/bin/env bash
# session-layout <tmux-session> [subject] — open (or join) the two-pane layout:
# list on the left (session-tui), main pane on the right (session-home, then
# whichever session the list opens). Inside tmux it switches, outside it attaches.
# An existing session whose list pane is gone gets it back before joining.
# Commands get an explicit PATH: tmux runs them without the .zshrc.
set -euo pipefail
S="${1:?usage: session-layout <tmux-session> [subject]}"; SUBJ="${2:-}"
BIN=$(cd "$(dirname "$0")" && pwd)
ENVP="env PATH=$(printf %q "$BIN:$PATH")"
ROOT="$HOME"
[ -z "$SUBJ" ] || ROOT=$(session-subject-roots 2>/dev/null | awk -F'\t' -v s="$SUBJ" '$1==s{print $2}' || true)
ROOT="${ROOT:-$HOME}"
split_list() {   # split_list <main-pane>
  local list
  list=$(tmux split-window -h -b -l 38 -P -F '#{pane_id}' -t "$1" -c "$ROOT" \
    "$ENVP $(printf %q "$BIN/session-tui") $(printf %q "$SUBJ")")
  tmux set-option -w -t "$S" @sessions_list "$list"
}
if ! tmux has-session -t "=$S" 2>/dev/null; then
  tmux new-session -d -s "$S" -c "$ROOT" "$ENVP $(printf %q "$BIN/session-home") $(printf %q "$SUBJ")"
  tmux set-option -t "$S" @sessions_subject "$SUBJ"
  MAIN=$(tmux display -p -t "$S" '#{pane_id}')
  tmux set-option -w -t "$S" @sessions_main "$MAIN"
  tmux set-option -p -t "$MAIN" remain-on-exit on
  split_list "$MAIN"
else
  LIST=$(tmux show -wv -t "$S" @sessions_list 2>/dev/null || true)
  if [ -z "$LIST" ] || ! tmux display -p -t "$LIST" '#{pane_id}' >/dev/null 2>&1; then
    MAIN=$(tmux show -wv -t "$S" @sessions_main 2>/dev/null || true)
    [ -z "$MAIN" ] || split_list "$MAIN"
  fi
fi
if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$S"; else exec tmux attach -t "=$S"; fi
